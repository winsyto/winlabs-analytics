# =============================================================================
# WinLabs Analytics — Variables de entorno
# Copiar a .env.local y completar los valores.
# NUNCA commitear .env.local (está en .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS
# Desarrollo local: apunta a PostgreSQL local
# Preview/Producción: apunta a Supabase (se configura en Vercel, no aquí)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://wla_dev:wla_dev_local@localhost:5432/winlabs_analytics_dev"

# Solo necesarias en preview/producción (configurar en Vercel)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# NEXTAUTH
# -----------------------------------------------------------------------------
# URL de la app (cambiar por dominio real en prod)
NEXTAUTH_URL="http://localhost:3000"
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=

# Para apps/cmp (console), usar puerto 3001
# NEXTAUTH_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# SENTRY (configurar cuando se integre en Paso 14)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# RESEND — email transaccional (configurar en Paso 15)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# TRIGGER.DEV — jobs (configurar en Paso 16)
# -----------------------------------------------------------------------------
TRIGGER_API_KEY=
TRIGGER_PROJECT_REF=

# -----------------------------------------------------------------------------
# AI PROVIDERS (configurar en M5)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
TOGETHER_API_KEY=
# Opcionales:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
TENANT_ROUTING_MODE=session   # session (nuestro modelo: dos subdominios fijos)
