# ============================================================
# apps/cmp — Console interno WinLabs Analytics
# Copiar a .env.local y completar valores. NUNCA commitear .env.local
# ============================================================

# --- Base de datos ---
# Dev local:  postgresql://wla_dev:PASSWORD@localhost:5432/winlabs_analytics_dev
# Prod:       URL Supabase con pgbouncer (ver vars comentadas abajo)
DATABASE_URL=
DIRECT_URL=

# --- NextAuth v5 ---
# Generar AUTH_SECRET con: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3001

# --- App ---
APP_BASE_URL=http://localhost:3001
TENANT_ROUTING_MODE=session

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Resend (email transaccional) ---
RESEND_API_KEY=

# --- Supabase (solo producción — no usar en dev local) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Producción (descomentar y usar en Vercel, no en .env.local) ---
# DATABASE_URL=https://YOUR_PROJECT.supabase.co?pgbouncer=true
# DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# AUTH_SECRET=<valor generado con openssl>
# AUTH_URL=https://winlabs-analytics-cmp.vercel.app
