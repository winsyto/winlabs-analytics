# PostgreSQL connection string (Supabase session pooler — postgres superuser bypasses RLS)
# Format: postgresql://postgres:[DB_PASSWORD]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Worker identification
WORKER_ID=worker-vps-01

# Loops
SCHEDULER_ENABLED=true
PROCESSOR_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
PROCESSOR_POLL_INTERVAL_SECONDS=10
JOB_HEARTBEAT_SECONDS=30
MAX_CONCURRENT_JOBS=2

# Cloudflare R2 — S3-compatible object storage
# R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=integration-files
