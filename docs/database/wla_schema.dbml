// WinLabs Analytics — Diccionario de datos
// Fuente única de verdad para el schema de BD.
// Sincronizado con packages/db/prisma/schema.prisma
// Visualizar en: https://dbdiagram.io

// ============================================================
// PLATAFORMA (sin prefijo — tablas de M0, sin RLS)
// ============================================================

Table tenants {
  id         uuid        [pk, note: 'UUID generado por gen_random_uuid()']
  slug       varchar(32) [not null, unique, note: 'Identificador único URL-safe del tenant. Ej: acme, globo-corp']
  name       varchar(80) [not null, note: 'Nombre visible del tenant']
  is_active       bool        [not null, default: true, note: 'false = tenant desactivado, no puede loguearse']
  active_modules  varchar[]   [not null, default: `ARRAY[]::varchar[]`, note: 'Módulos analíticos activos para este tenant. Valores: people, time, payroll']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  Note: 'Tenants de la plataforma. Sin RLS — visible para service role.'
}

Table internal_users {
  id            uuid        [pk]
  email         varchar(255)[not null, unique, note: 'Email del usuario interno WinLabs']
  name          varchar(80) [not null]
  password_hash varchar     [not null, note: 'bcrypt hash. NUNCA hashear dentro de transaction.']
  is_active     bool        [not null, default: true]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  Note: 'Usuarios internos de WinLabs para el CMP. Sin RLS.'
}

Table users {
  id            uuid        [pk]
  tenant_id     uuid        [not null, ref: > tenants.id, note: 'RLS — tenant owner']
  email         varchar(255)[not null, note: 'Email único por tenant']
  name          varchar(80) [not null]
  password_hash varchar     [not null, note: 'bcrypt hash. NUNCA hashear dentro de transaction.']
  is_active     bool        [not null, default: true]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, email) [unique, name: 'uq_users_tenant_email']
  }

  Note: 'Usuarios de cada tenant. RLS por tenant_id.'
}

Table roles {
  id          uuid        [pk]
  tenant_id   uuid        [not null, ref: > tenants.id]
  name        varchar(50) [not null, note: 'admin | analyst | viewer']
  description varchar(200)
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, name) [unique, name: 'uq_roles_tenant_name']
  }

  Note: 'Roles por tenant. RLS por tenant_id. Creados automáticamente al crear un tenant.'
}

Table user_roles {
  id         uuid        [pk]
  tenant_id  uuid        [not null, ref: > tenants.id]
  user_id    uuid        [not null, ref: > users.id]
  role_id    uuid        [not null, ref: > roles.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_roles_user_role']
  }

  Note: 'Asignación de roles a usuarios. RLS por tenant_id.'
}

Table audit_log {
  id         uuid        [pk]
  tenant_id  uuid        [ref: > tenants.id, note: 'null = evento global / cross-tenant']
  actor_id   uuid        [note: 'ID del usuario o internal_user que ejecutó la acción']
  actor_type varchar(20) [not null, note: 'user | internal_user | system | agent']
  action     varchar(100)[not null, note: 'Ej: user.create, tenant_integration.update']
  target_type varchar(50)
  target_id  varchar(100)
  payload    jsonb       [note: 'Contexto de la acción: before/after, diff, etc.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, created_at)
    (actor_id, created_at)
  }

  Note: 'Log de auditoría append-only. RLS por tenant_id.'
}

// ============================================================
// M1 — CATÁLOGOS GLOBALES (sin tenant_id, sin RLS)
// ============================================================

Table cfg_org_unit_types {
  id          int         [pk, increment, note: 'PK autoincrement']
  code        varchar(50) [not null, unique, note: 'Código del tipo de OU. Ej: AREA, POSITION, LOCATION, COST_CENTER, BUSINESS_UNIT']
  name        varchar(100)[not null, note: 'Nombre legible del tipo']
  description text        [note: 'Descripción opcional del tipo']
  is_active   bool        [not null, default: true, note: 'false = tipo desactivado, no se puede asignar a nuevas instancias']
  sort_order  int         [not null, default: 0, note: 'Orden de presentación en listados y archivos']

  Note: 'Catálogo global de 15 tipos de unidad organizacional (Empresa, Sucursal, Área, Puesto, Contrato, ...). Sin RLS. Poblado por migración y seed. Cada tenant habilita los que usa en cfg_tenant_org_unit_types.'
}

Table cfg_termination_reasons {
  id          int         [pk, increment]
  code        varchar(50) [not null, unique, note: 'Código canónico. Ej: VOLUNTARY_RESIGNATION, DISMISSAL, END_OF_CONTRACT']
  name        varchar(100)[not null, note: 'Nombre legible']
  category    varchar(30) [not null, note: 'voluntary | involuntary | end_of_contract | retirement | other']
  is_active   bool        [not null, default: true]

  Note: 'Catálogo global de motivos de baja. Sin RLS — genérico entre tenants. Los ETL mapean sus códigos origen a este catálogo.'
}

Table cfg_time_entry_types {
  code          varchar(50) [pk, note: 'Código del tipo de hora. Ej: REGULAR, NIGHT, OT50, OT100, OT50NA, ABSENT']
  name          varchar(100)[not null, note: 'Nombre legible']
  category      varchar(30) [not null, note: 'regular | overtime | overtime_na | training | holiday | absence | other']
  sign          smallint    [not null, default: 1, note: '+1 suma al total trabajado, -1 detrae. Ej: ABSENT = -1']
  sort_order    int         [not null, default: 0]
  is_active     bool        [not null, default: true]

  Note: 'Catálogo global de tipos de hora (base que se copia a cada tenant nuevo). Sin RLS.'
}

// ============================================================
// M1 — PEOPLE
// ============================================================

Table hr_org_units {
  id                  int         [pk, increment]
  tenant_id           uuid        [not null, ref: > tenants.id, note: 'RLS — tenant owner']
  org_unit_type_id    int         [not null, ref: > cfg_org_unit_types.id, note: 'Tipo de OU (AREA, POSITION, LOCATION, etc.)']
  code                varchar(50) [not null, note: 'Código del sistema origen. Único por tenant + tipo']
  name                varchar(150)[not null, note: 'Nombre de la unidad organizacional']
  parent_org_unit_id  int         [ref: > hr_org_units.id, note: 'Self-ref para jerarquía. null = raíz']
  level               int         [note: 'Profundidad en el árbol (0 = raíz). Calculable pero almacenado para performance']
  is_active           bool        [not null, default: true]
  custom_fields       jsonb       [note: 'Extensiones por tenant/cliente']
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]
  deleted_at          timestamptz [note: 'Soft delete']

  indexes {
    (tenant_id, org_unit_type_id, code) [unique, name: 'uq_hr_org_units_tenant_type_code']
    (tenant_id, org_unit_type_id)       [name: 'idx_hr_org_units_tenant_type']
    (parent_org_unit_id)                [name: 'idx_hr_org_units_parent']
  }

  Note: 'Instancias de unidades organizacionales por tenant. Reemplaza hr_areas + hr_positions + hr_locations con un modelo genérico. RLS por tenant_id.'
}

Table hr_people {
  id                     int         [pk, increment]
  tenant_id              uuid        [not null, ref: > tenants.id, note: 'RLS — tenant owner']
  employee_code          varchar(50) [not null, note: 'Código del empleado en el sistema origen. Único por tenant']
  full_name              varchar(200)[not null, note: 'Nombre completo (puede ser el único campo de nombre disponible)']
  first_name             varchar(100)[note: 'Nombre(s) — opcional, poblado cuando el origen lo provee separado']
  last_name              varchar(100)[note: 'Apellido(s) — opcional']
  email                  varchar(255)[note: 'Email laboral o personal']
  birth_date             date        [note: 'Fecha de nacimiento — para cálculo de edad y segmentación']
  gender                 varchar(20) [note: 'M | F | X | no_decl. varchar para tolerar valores variados de orígenes distintos']
  nationality            varchar(100)[note: 'Nacionalidad — para segmentación demográfica']
  document_type          varchar(30) [note: 'Tipo de documento principal. Ej: DNI, CUIL, RUT, CC']
  document_number        varchar(50) [note: 'Número de documento principal']
  hire_date              date        [not null, note: 'Fecha de ingreso — base para cálculo de antigüedad']
  termination_date       date        [note: 'Fecha de egreso. null = activo o con estado on_leave']
  termination_reason_id  int         [ref: > cfg_termination_reasons.id, note: 'Motivo de baja del catálogo global']
  status                 varchar(20) [not null, note: 'active | inactive | on_leave']
  manager_id             int         [ref: > hr_people.id, note: 'Self-ref — jefe directo. null = sin manager o top-level']
  salary_band            varchar(50) [note: 'Banda salarial (etiqueta, no monto exacto). Ej: B3, Senior, L4']
  custom_fields          jsonb       [note: 'Extensiones por tenant — campos del origen que no tienen columna canónica']
  created_at             timestamptz [not null, default: `now()`]
  updated_at             timestamptz [not null, default: `now()`]
  deleted_at             timestamptz [note: 'Soft delete — empleados eliminados por error de carga']

  indexes {
    (tenant_id, employee_code) [unique, name: 'uq_hr_people_tenant_code']
    (tenant_id, status)        [name: 'idx_hr_people_tenant_status']
    (tenant_id, hire_date)     [name: 'idx_hr_people_tenant_hire_date']
    (manager_id)               [name: 'idx_hr_people_manager']
  }

  Note: 'Empleados del tenant. Un empleado = una fila. Dimensiones organizacionales via hr_people_org_assignments. RLS por tenant_id.'
}

Table hr_people_org_assignments {
  id                 int  [pk, increment]
  tenant_id          uuid [not null, ref: > tenants.id, note: 'RLS — denormalizado para simplificar RLS policy']
  person_id          int  [not null, ref: > hr_people.id, note: 'Empleado asignado']
  org_unit_id        int  [not null, ref: > hr_org_units.id, note: 'Unidad organizacional asignada. FK compuesta (org_unit_id, org_unit_type_code) garantiza coherencia con el tipo']
  org_unit_type_code text [not null, ref: > cfg_org_unit_types.code, note: 'Tipo de la unidad (denormalizado para la restricción de exclusión)']
  valid_from         date [not null, note: 'Inicio de vigencia de la asignación']
  valid_to           date [note: 'Fin de vigencia inclusive. NULL = vigente']
  created_at         timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, person_id, org_unit_id, valid_from) [unique, name: 'uq_hr_people_org_assignments']
    (tenant_id, org_unit_id)                        [name: 'idx_hr_people_org_assignments_ou']
    (tenant_id, org_unit_type_code, valid_from, valid_to) [name: 'idx_hr_people_org_assignments_type_validity']
  }

  Note: 'Historia de unidades organizacionales por persona con vigencia (fuente de verdad). Una sola asignación por persona y tipo en cada momento (EXCLUDE USING gist sobre daterange(valid_from, valid_to)); CHECK valid_to >= valid_from. RLS por tenant_id.'
}

Table cfg_tenant_org_unit_types {
  id                 int         [pk, increment]
  tenant_id          uuid        [not null, ref: > tenants.id, note: 'RLS — tenant owner. ON DELETE CASCADE']
  org_unit_type_code text        [not null, ref: > cfg_org_unit_types.code, note: 'Tipo del catálogo global']
  is_enabled         bool        [not null, default: true, note: 'true = el tenant usa este tipo']
  sort_order         int         [not null, default: 0, note: 'Orden de presentación para el tenant']
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null]

  indexes {
    (tenant_id, org_unit_type_code) [unique, name: 'uq_cfg_tenant_org_unit_types']
  }

  Note: 'Tipos de unidad organizacional que usa cada tenant. Se administra desde el CMP. RLS por tenant_id.'
}

Table cfg_dashboards {
  code             varchar(50)  [pk]
  name             varchar(100) [not null]
  description      varchar(300)
  route            varchar(100) [not null, note: 'Ruta base en la app del cliente']
  required_modules text[]       [not null, note: 'people | time | payroll']
  category         varchar(30)  [not null, default: 'other', note: 'hr | finance | other: agrupa el hub de dashboards']
  icon             varchar(40)  [note: 'Ícono lucide en kebab-case']
  sort_order       int          [not null, default: 0]
  is_active        bool         [not null, default: true]
  created_at       timestamp    [not null]
  updated_at       timestamp    [not null]

  Note: 'Catálogo global de dashboards (hub). Sin RLS.'
}

Table dsh_tenant_dashboards {
  id             int          [pk, increment]
  tenant_id      uuid         [not null, ref: > tenants.id, note: 'RLS']
  dashboard_code varchar(50)  [not null, ref: > cfg_dashboards.code]
  is_enabled     bool         [not null, default: true]
  allowed_roles  text[]       [not null, default: '{admin,analyst,viewer}', note: 'Preparado para permisos por opción de menú; hoy no se usa']
  created_at     timestamp    [not null]
  updated_at     timestamp    [not null]

  indexes {
    (tenant_id, dashboard_code) [unique, name: 'uq_dsh_tenant_dashboards']
    dashboard_code
  }

  Note: 'Dashboards activos de cada tenant. RLS por tenant_id.'
}

Table dsh_dimensions {
  id                 int         [pk, increment]
  tenant_id          uuid        [not null, ref: > tenants.id, note: 'RLS — tenant owner. ON DELETE CASCADE']
  dashboard_code     varchar(50) [not null, note: 'Dashboard al que aplica. Ej: headcount']
  org_unit_type_code text        [not null, ref: > cfg_org_unit_types.code, note: 'Tipo usado como dimensión (filtro y distribución). Debe estar habilitado para el tenant']
  sort_order         int         [not null, default: 0, note: 'Orden de la dimensión dentro del dashboard']
  created_at         timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, dashboard_code, org_unit_type_code) [unique, name: 'uq_dsh_dimensions']
  }

  Note: 'Dimensiones de cada dashboard por tenant. Defaults del headcount: COMPANY, LOCATION, AREA, POSITION, CONTRACT. Son columnas obligatorias del archivo de Personas. RLS por tenant_id.'
}

Table hr_people_history {
  id                       int         [pk, increment]
  tenant_id                uuid        [not null, ref: > tenants.id, note: 'RLS — tenant owner']
  snapshot_date            date        [not null, note: 'Primer día del mes del snapshot: YYYY-MM-01']
  person_id                int         [not null, ref: > hr_people.id, note: 'Referencia al empleado (puede estar inactivo)']
  employee_code            varchar(50) [not null, note: 'Snapshot del código al momento del cierre']
  status                   varchar(20) [not null, note: 'Estado al cierre del mes']
  org_assignments_snapshot jsonb       [note: 'Array de asignaciones OU al momento del snapshot. Ej: [{type: "AREA", code: "VEN", name: "Ventas"}, ...]']
  manager_id               int         [ref: > hr_people.id, note: 'Manager al cierre del mes']
  salary_band              varchar(50) [note: 'Banda salarial al cierre']
  tenure_months            int         [note: 'Antigüedad calculada en meses al cierre del mes']
  custom_fields_snapshot   jsonb       [note: 'Snapshot de custom_fields al momento del cierre']
  created_at               timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, snapshot_date, person_id) [unique, name: 'uq_hr_people_history_snapshot']
    (tenant_id, snapshot_date)            [name: 'idx_hr_people_history_tenant_date']
    (tenant_id, person_id)               [name: 'idx_hr_people_history_person']
  }

  Note: 'Snapshots mensuales del estado de cada empleado. Generados por job el día 1 de cada mes. Base para métricas históricas de headcount y turnover. RLS por tenant_id.'
}

// ============================================================
// M1 — CONFIG POR TENANT
// ============================================================

Table cfg_tenant_time_entry_types {
  id            int         [pk, increment]
  tenant_id     uuid        [not null, ref: > tenants.id, note: 'RLS — cada tenant define la categoría de sus tipos de hora']
  code          varchar(50) [not null, note: 'Código del tipo en el sistema origen']
  name          varchar(100)[not null]
  category      varchar(30) [not null, note: 'regular | overtime | overtime_na | training | holiday | absence | other. overtime = hora extra (forma la tasa); overtime_na = hora extra no autorizada (se muestra aparte)']
  sign          smallint    [not null, default: 1, note: '+1 / -1']
  is_classified bool        [not null, default: true, note: 'false = creado desde un archivo, pendiente de clasificar']
  sort_order    int         [not null, default: 0]
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null]

  indexes {
    (tenant_id, code) [unique, name: 'uq_cfg_tenant_time_entry_types_tenant_code']
  }

  Note: 'Tipos de hora por tenant (copia del catálogo cfg_time_entry_types). RLS por tenant_id. El portal define la categoría; el archivo no la pisa.'
}

Table cfg_absenteeism_types {
  id                int         [pk, increment]
  tenant_id         uuid        [not null, ref: > tenants.id, note: 'RLS — cada tenant define sus propios tipos de ausentismo']
  code              varchar(50) [not null, note: 'Código del tipo en el sistema origen']
  name              varchar(100)[not null, note: 'Nombre legible']
  class             varchar(30) [not null, note: 'medical | accident | unpaid | unjustified | suspension | personal | other | vacation | legal_leave | day_off']
  counts_as_absence bool        [not null, default: true, note: 'false = tipo que no impacta en la tasa de ausentismo (ej: capacitación)']
  is_classified     bool        [not null, default: true, note: 'false = creado desde un archivo, pendiente de clasificar']
  custom_fields     jsonb

  indexes {
    (tenant_id, code) [unique, name: 'uq_cfg_absenteeism_types_tenant_code']
  }

  Note: 'Tipos de ausentismo por tenant. RLS por tenant_id — cada cliente tiene sus propios códigos mapeados desde el sistema origen.'
}

// ============================================================
// M1 — TIME & ATTENDANCE
// ============================================================

Table att_time_daily {
  id                    int          [pk, increment]
  tenant_id             uuid         [not null, ref: > tenants.id, note: 'RLS']
  person_id             int          [not null, ref: > hr_people.id]
  date                  date         [not null, note: 'Fecha del registro diario']
  is_working_day        bool         [not null, note: 'true = día hábil según calendario laboral del tenant/persona']
  scheduled_hours       numeric(5,2) [not null, default: 0, note: 'Horas teóricas planificadas. 0 si is_working_day = false']
  worked_hours          numeric(5,2) [not null, default: 0, note: 'Total horas trabajadas independientemente de su categorización']
  has_absence           bool         [not null, default: false, note: 'Flag de conveniencia — true si existe al menos una entrada de tipo ABSENT para este día']
  source_integration_id int          [note: 'FK int_tenant_integrations — integración que originó este registro']
  custom_fields         jsonb
  created_at            timestamptz  [not null, default: `now()`]
  updated_at            timestamptz  [not null, default: `now()`]

  indexes {
    (tenant_id, person_id, date) [unique, name: 'uq_att_time_daily_tenant_person_date']
    (tenant_id, date)            [name: 'idx_att_time_daily_tenant_date']
  }

  Note: 'Agregado diario de asistencia por persona. Una fila por persona × día. El desglose por tipo de hora va en att_time_daily_entries. RLS por tenant_id.'
}

Table att_time_daily_entries {
  id                  int          [pk, increment]
  tenant_id           uuid         [not null, ref: > tenants.id, note: 'RLS — denormalizado para simplificar policy']
  time_daily_id       int          [not null, ref: > att_time_daily.id, note: 'Día al que pertenece esta entrada']
  time_entry_type_id  int          [not null, ref: > cfg_tenant_time_entry_types.id, note: 'Tipo de hora del tenant (OT50, NIGHT, REGULAR, etc.)']
  hours               numeric(6,2) [not null, note: 'Cantidad de horas de este tipo en el día']
  created_at          timestamptz  [not null, default: `now()`]

  indexes {
    (tenant_id, time_daily_id, time_entry_type_id) [unique, name: 'uq_att_time_daily_entries']
    (tenant_id, time_entry_type_id)                [name: 'idx_att_time_daily_entries_type']
  }

  Note: 'Horas tipificadas por día y persona. N entradas por att_time_daily (una por tipo de hora presente). RLS por tenant_id.'
}

Table att_absenteeism_events {
  id                    int          [pk, increment]
  tenant_id             uuid         [not null, ref: > tenants.id, note: 'RLS']
  person_id             int          [not null, ref: > hr_people.id]
  absenteeism_type_id   int          [not null, ref: > cfg_absenteeism_types.id]
  start_date            date         [not null]
  end_date              date         [not null]
  days_count            numeric(5,2) [note: 'Días del evento (puede ser fraccionario). NULL = no vino en el archivo: lo calcula el dashboard con el turno']
  hours_count           numeric(6,2) [note: 'Horas de ausencia POR DÍA en una ausencia parcial (4 = medio día). NULL = día completo']
  justified             bool         [not null, default: false]
  cost_estimated        numeric(12,2)[note: 'Costo estimado del evento. Puede venir del ETL de Payroll']
  status                varchar(20)  [not null, default: 'open', note: 'open | closed | cancelled']
  notes                 text
  source_integration_id int          [note: 'Integración origen']
  custom_fields         jsonb
  created_at            timestamptz  [not null, default: `now()`]
  updated_at            timestamptz  [not null, default: `now()`]

  indexes {
    (tenant_id, person_id, start_date) [name: 'idx_att_absenteeism_events_person_date']
    (tenant_id, absenteeism_type_id)   [name: 'idx_att_absenteeism_events_type']
  }

  Note: 'Eventos de ausentismo por persona. Tabla maestra de ausencias — el agregado diario de horas ausentes también se refleja en att_time_daily_entries. RLS por tenant_id.'
}

// ============================================================
// M1 — PAYROLL (simplificado — solo lo necesario para analytics)
// ============================================================

Table pay_periods {
  id           int         [pk, increment]
  tenant_id    uuid        [not null, ref: > tenants.id, note: 'RLS']
  period_code  varchar(20) [not null, note: 'Mes de liquidación AAAA-MM. Ej: 2026-01']
  start_date   date        [not null]
  end_date     date        [not null]
  status       varchar(20) [not null, default: 'open', note: 'open | closed | cancelled']
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, period_code) [unique, name: 'uq_pay_periods_tenant_code']
  }

  Note: 'Períodos de liquidación por tenant. RLS por tenant_id.'
}

Table pay_processes {
  id           int         [pk, increment]
  tenant_id    uuid        [not null, ref: > tenants.id, note: 'RLS']
  period_id    int         [not null, ref: > pay_periods.id]
  code         varchar(50) [not null, note: 'Código del proceso en el sistema origen (único dentro del período)']
  description  varchar(200)
  process_type varchar(30) [not null, default: 'monthly', note: 'monthly | biweekly | weekly | sac | adjustments | provisions | final_settlement | vacation']
  start_date   date        [not null]
  end_date     date        [not null, note: 'CHECK end_date >= start_date']
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, period_id, code) [unique, name: 'uq_pay_processes_period_code']
    period_id
  }

  Note: 'Procesos de liquidación de un período (mensual, quincenal, SAC, ajustes...). RLS por tenant_id.'
}

Table pay_concepts {
  id              int         [pk, increment]
  tenant_id       uuid        [not null, ref: > tenants.id, note: 'RLS']
  code            varchar(50) [not null, note: 'Código del concepto en el sistema origen']
  name            varchar(100)[not null]
  concept_type    varchar(40) [note: 'employee_contribution | additional | family_allowance | employer_contribution | deductions | garnishments | loans | income_tax | non_remunerative | provisions | sac | salary | accumulators. null = sin clasificar']
  reference_total varchar(10) [note: 'gross | net: el acumulador que es el sueldo bruto / neto (índice único parcial por tenant)']
  is_classified   bool        [not null, default: true, note: 'false = llegó de un archivo y falta clasificarlo']
  is_active       bool        [not null, default: true]
  custom_fields   jsonb

  indexes {
    (tenant_id, code) [unique, name: 'uq_pay_concepts_tenant_code']
  }

  Note: 'Catálogo de conceptos de liquidación por tenant. RLS por tenant_id.'
}

Table pay_concept_classes {
  id         int          [pk, increment]
  tenant_id  uuid         [not null, ref: > tenants.id, note: 'RLS']
  code       varchar(50)  [not null]
  name       varchar(100) [not null]
  side       varchar(10)  [not null, note: 'earning (suma a la masa bruta) | deduction (retención)']
  sort_order int          [not null, default: 0]
  is_active  bool         [not null, default: true]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]

  indexes {
    (tenant_id, code) [unique, name: 'uq_pay_concept_classes_tenant_code']
  }

  Note: 'Clases de concepto del dashboard de Payroll (seed base de 6, editables por tenant). RLS por tenant_id.'
}

Table pay_class_rules {
  id           int         [pk, increment]
  tenant_id    uuid        [not null, ref: > tenants.id, note: 'RLS']
  class_id     int         [not null, ref: > pay_concept_classes.id]
  concept_type varchar(40) [note: 'Todos los conceptos de este tipo van a la clase']
  concept_id   int         [ref: > pay_concepts.id, note: 'Un concepto puntual (gana sobre el tipo)']
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    class_id
    concept_id
  }

  Note: 'Reglas de pertenencia a una clase: por tipo o por concepto (CHECK: exactamente uno). Índices únicos parciales: un tipo y un concepto pertenecen a una sola clase por tenant. RLS por tenant_id.'
}

Table pay_entries {
  id                    int          [pk, increment]
  tenant_id             uuid         [not null, ref: > tenants.id, note: 'RLS']
  process_id            int          [not null, ref: > pay_processes.id]
  person_id             int          [not null, ref: > hr_people.id]
  concept_id            int          [not null, ref: > pay_concepts.id]
  amount                numeric(14,2)[not null, note: 'Importe con el signo con el que viene del sistema origen']
  quantity              numeric(6,2) [note: 'Cantidad asociada (horas, días, unidades). null si no aplica']
  source_integration_id int          [note: 'Integración origen']
  custom_fields         jsonb
  created_at            timestamptz  [not null, default: `now()`]

  indexes {
    (tenant_id, process_id, person_id, concept_id) [unique, name: 'uq_pay_entries_process_person_concept']
    process_id
    person_id
    concept_id
  }

  Note: 'Líneas de liquidación por proceso × persona × concepto (incluye los acumuladores). RLS por tenant_id.'
}

// ============================================================
// M1-B — INTEGRACIONES
// ============================================================

Table int_templates {
  code          varchar(50)  [pk, note: 'Slug único del template. Ej: file_people, api_manu, api_geovictoria']
  name          varchar(100) [not null, note: 'Nombre display del template']
  category      varchar(20)  [not null, note: 'file | api — tipo de fuente de datos']
  target_model  varchar(40)  [not null, note: 'people | time | payroll | absenteeism — modelo canónico que puebla']
  config_schema jsonb        [note: 'JSON Schema que valida el campo config de int_tenant_integrations']
  is_active     bool         [not null, default: true, note: 'false = template desactivado globalmente (no aparece en UI)']
  created_at    timestamptz  [not null, default: `now()`]

  Note: 'Catálogo global de templates de integración. Sin RLS — gestionado por WinLabs vía seed/migrations.'
}

Table int_tenant_integrations {
  id                       int         [pk, increment]
  tenant_id                uuid        [not null, ref: > tenants.id, note: 'RLS — cada fila pertenece a un tenant']
  integration_template_code varchar(50) [not null, ref: > int_templates.code, note: 'Template que implementa esta integración']
  name                     varchar(100)[not null, note: 'Nombre amigable definido por el tenant. Ej: Nómina mensual Acme']
  status                   varchar(20) [not null, default: 'active', note: 'active | paused | error']
  schedule_cron            varchar(100)[note: 'Expresión cron. Null si la integración es solo manual']
  config                   jsonb       [not null, note: 'Reglas de mapping, filtros, value maps y defaults. Validado contra int_templates.config_schema']
  last_run_at              timestamptz [note: 'Timestamp del último run iniciado (exitoso o no)']
  last_success_at          timestamptz [note: 'Timestamp del último run completado sin errores fatales']
  is_active                bool        [not null, default: true, note: 'false = integración desactivada por el tenant']
  created_at               timestamptz [not null, default: `now()`]
  updated_at               timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, integration_template_code) [name: 'idx_int_tenant_integrations_template']
  }

  Note: 'Integraciones activas por tenant. Una fila por integración configurada. El campo config almacena todo el mapping y las reglas. RLS por tenant_id.'
}

Table int_runs {
  id                     int         [pk, increment]
  tenant_id              uuid        [not null, ref: > tenants.id, note: 'RLS — denormalizado para simplificar policy']
  tenant_integration_id  int         [not null, ref: > int_tenant_integrations.id, note: 'Integración que originó este run']
  status                 varchar(20) [not null, note: 'running | success | partial | failed']
  trigger_source         varchar(20) [not null, note: 'cron | manual | upload']
  triggered_by           varchar(36) [note: 'UUID del usuario que disparó el run, o null si fue automático']
  started_at             timestamptz [not null, note: 'Inicio del run']
  finished_at            timestamptz [note: 'Fin del run. Null si sigue corriendo']
  rows_read              int         [not null, default: 0, note: 'Filas leídas de la fuente']
  rows_loaded            int         [not null, default: 0, note: 'Filas persistidas exitosamente en BD']
  rows_error             int         [not null, default: 0, note: 'Filas descartadas por error de validación o mapping']
  rows_warning           int         [not null, default: 0, note: 'Filas procesadas con advertencias (reconciliación pendiente, etc.)']
  error_message          text        [note: 'Mensaje de error fatal si status = failed. Null en runs exitosos']
  created_at             timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, tenant_integration_id, started_at) [name: 'idx_int_runs_integration_date']
    (tenant_id, status)                            [name: 'idx_int_runs_status']
  }

  Note: 'Historial de ejecuciones por integración. Una fila por run. Los errores a nivel de fila se detallan en int_run_errors. RLS por tenant_id.'
}

Table int_run_errors {
  id          int         [pk, increment]
  tenant_id   uuid        [not null, ref: > tenants.id, note: 'RLS — denormalizado para simplificar policy']
  run_id      int         [not null, ref: > int_runs.id, note: 'Run al que pertenece este error']
  row_index   int         [note: 'Posición de la fila en el archivo o respuesta API. Null si el error no es de fila']
  row_data    jsonb       [note: 'Datos crudos de la fila que falló. Para debug y reporte de errores descargable']
  error_code  varchar(50) [not null, note: 'Código de error. Ej: VALIDATION_ERROR, MAPPING_ERROR, RECONCILIATION_PENDING']
  error_message text      [not null, note: 'Descripción legible del error']
  severity    varchar(10) [not null, default: 'error', note: 'error | warning']
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (tenant_id, run_id)           [name: 'idx_int_run_errors_run']
    (tenant_id, run_id, severity) [name: 'idx_int_run_errors_severity']
  }

  Note: 'Errores y advertencias a nivel de fila por run de integración. Usados para el reporte descargable de errores en UI. RLS por tenant_id.'
}


Table cfg_absenteeism_type_defaults {
  id                int          [pk, increment]
  code              varchar(50)  [not null, unique]
  name              varchar(100) [not null]
  class             varchar(30)  [not null, note: 'Mismas clases que cfg_absenteeism_types.class']
  counts_as_absence bool         [not null, default: true]
  sort_order        int          [not null, default: 0]
  is_active         bool         [not null, default: true]

  Note: 'Catálogo global (sin RLS) de tipos de ausencia por defecto; se copia a cada tenant nuevo (applyDefaultAbsenteeismTypes).'
}

Table hr_shift_schedules {
  id                 int         [pk, increment]
  tenant_id          uuid        [not null, ref: > tenants.id, note: 'RLS']
  org_unit_id        int         [not null, unique, note: 'FK compuesta (org_unit_id, org_unit_type_code) a hr_org_units; el tipo es siempre SHIFT']
  org_unit_type_code text        [not null, default: 'SHIFT']
  daily_hours        decimal(4,2) [not null, note: 'Horas por día trabajado']
  weekly_hours       decimal(5,2)
  monthly_hours      decimal(6,2)
  work_week          char(7)     [not null, note: '7 caracteres 0/1, lunes a domingo. 1111100 = lunes a viernes']
  created_at         timestamp   [not null]
  updated_at         timestamp   [not null]

  Note: 'Horario de una unidad de tipo SHIFT. Sin fila = usa el horario por defecto del tenant. RLS por tenant_id.'
}

Table cfg_tenant_settings {
  id                  int          [pk, increment]
  tenant_id           uuid         [not null, unique, ref: - tenants.id, note: 'RLS']
  attendance_mode     varchar(20)  [not null, default: 'basic', note: 'basic (turnos SHIFT) | detailed (asistencia diaria por integración)']
  default_work_week   char(7)      [not null, default: '1111100', note: 'Semana laboral de quien no tiene turno, lunes a domingo']
  default_daily_hours decimal(4,2) [not null, default: 8]
  absence_display     varchar(10)  [not null, default: 'both', note: 'hours | days | both']
  overtime_base       varchar(10)  [not null, default: 'scheduled', note: 'scheduled | worked: base de la tasa de horas extra']
  currency            char(3)      [not null, default: 'ARS', note: 'Moneda del tenant (ISO 4217); una por tenant']
  created_at          timestamp    [not null]
  updated_at          timestamp    [not null]

  Note: 'Ajustes de asistencia y visualización por tenant. RLS por tenant_id.'
}

Table cfg_tenant_metric_targets {
  id           int          [pk, increment]
  tenant_id    uuid         [not null, ref: > tenants.id, note: 'RLS']
  metric_code  varchar(50)  [not null, note: 'absenteeism_rate | overtime_rate | turnover_rate']
  target_value decimal(8,2) [not null, note: '0 a 100']
  unit         varchar(20)  [not null, note: 'percent_monthly | percent_annual']
  created_at   timestamp    [not null]
  updated_at   timestamp    [not null]

  indexes {
    (tenant_id, metric_code) [unique, name: 'uq_cfg_tenant_metric_targets']
  }

  Note: 'Metas (benchmarks) por tenant. Sin fila = valor por defecto del código (METRIC_TARGET_DEFAULTS). RLS por tenant_id.'
}
