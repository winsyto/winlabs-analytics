generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// TENANTS
// =============================================================================
model Tenant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique
  name          String
  isActive      Boolean  @default(true) @map("is_active")
  /// Módulos analíticos activos. Valores posibles: people, time, payroll
  activeModules String[] @default([]) @map("active_modules")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users              User[]
  roles              Role[]
  auditLogs          AuditLog[]
  orgUnitTypeConfigs CfgTenantOrgUnitType[]
  dimensions         DshDimension[]

  @@map("tenants")
}

// =============================================================================
// INTERNAL USERS — usuarios WinLabs (acceden al CMP)
// =============================================================================
model InternalUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("internal_users")
}

// =============================================================================
// USERS — usuarios de clientes
// =============================================================================
model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  email              String
  passwordHash       String   @map("password_hash")
  name               String
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@map("users")
}

// =============================================================================
// ROLES
// =============================================================================
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

// =============================================================================
// USER_ROLES
// =============================================================================
model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// M1 — CATÁLOGOS GLOBALES (sin tenant_id, sin RLS)
// =============================================================================

model CfgOrgUnitType {
  /// Código único del tipo de OU. Ej: AREA, POSITION, LOCATION, COST_CENTER
  code        String  @unique
  /// Nombre legible del tipo
  name        String  @db.VarChar(100)
  /// Descripción opcional
  description String?
  /// false = no se puede asignar a nuevas instancias
  isActive    Boolean @default(true) @map("is_active")
  /// Orden de presentación en listados y archivos
  sortOrder   Int     @default(0) @map("sort_order")

  orgUnits      HrOrgUnit[]
  assignments   HrPeopleOrgAssignment[]
  tenantConfigs CfgTenantOrgUnitType[]
  dimensions    DshDimension[]

  @@id([code])
  @@map("cfg_org_unit_types")
}

model CfgTerminationReason {
  /// Código canónico. Ej: VOLUNTARY_RESIGNATION, DISMISSAL, END_OF_CONTRACT
  code     String  @unique @db.VarChar(50)
  /// Nombre legible
  name     String  @db.VarChar(100)
  /// voluntary | involuntary | end_of_contract | retirement | other
  category String  @db.VarChar(30)
  isActive Boolean @default(true) @map("is_active")

  people HrPerson[]

  @@id([code])
  @@map("cfg_termination_reasons")
}

model CfgTimeEntryType {
  /// Código único. Ej: OVERTIME, ABSENT, HOLIDAY, NIGHT, TRAINING
  code     String  @unique @db.VarChar(50)
  /// Nombre legible
  name     String  @db.VarChar(100)
  /// overtime | absence | special | other
  category String  @db.VarChar(30)
  /// +1 suma al total trabajado, -1 detrae (ej: ABSENT = -1)
  sign     Int     @default(1) @db.SmallInt
  isActive Boolean @default(true) @map("is_active")

  timeEntries AttTimeDailyEntry[]

  @@id([code])
  @@map("cfg_time_entry_types")
}

// =============================================================================
// M1 — PEOPLE
// =============================================================================

model HrOrgUnit {
  /// PK autoincrement
  id              Int       @id @default(autoincrement())
  /// RLS — tenant owner
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Tipo de OU (code de cfg_org_unit_types)
  orgUnitTypeCode String    @map("org_unit_type_code")
  /// Código del sistema origen (único por tenant + tipo)
  code            String    @db.VarChar(50)
  /// Nombre de la unidad organizacional
  name            String    @db.VarChar(150)
  /// Self-ref para jerarquía. null = raíz
  parentOrgUnitId Int?      @map("parent_org_unit_id")
  /// Profundidad en el árbol (0 = raíz)
  level           Int?
  isActive        Boolean   @default(true) @map("is_active")
  customFields    Json?     @map("custom_fields")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// Soft delete
  deletedAt       DateTime? @map("deleted_at")

  orgUnitType CfgOrgUnitType          @relation(fields: [orgUnitTypeCode], references: [code])
  parent      HrOrgUnit?              @relation("OrgUnitHierarchy", fields: [parentOrgUnitId], references: [id])
  children    HrOrgUnit[]             @relation("OrgUnitHierarchy")
  assignments HrPeopleOrgAssignment[]

  @@unique([id, orgUnitTypeCode], name: "uq_hr_org_units_id_type", map: "uq_hr_org_units_id_type")
  @@unique([tenantId, orgUnitTypeCode, code], name: "uq_hr_org_units_tenant_type_code")
  @@index([tenantId, orgUnitTypeCode])
  @@index([parentOrgUnitId])
  @@map("hr_org_units")
}

model HrPerson {
  /// PK autoincrement
  id                    Int       @id @default(autoincrement())
  /// RLS — tenant owner
  tenantId              String    @map("tenant_id") @db.Uuid
  /// Código del empleado en el sistema origen (único por tenant)
  employeeCode          String    @map("employee_code") @db.VarChar(50)
  /// Nombre completo
  fullName              String    @map("full_name") @db.VarChar(200)
  /// Nombre(s) — opcional
  firstName             String?   @map("first_name") @db.VarChar(100)
  /// Apellido(s) — opcional
  lastName              String?   @map("last_name") @db.VarChar(100)
  /// Email laboral o personal
  email                 String?   @db.VarChar(255)
  /// Fecha de nacimiento
  birthDate             DateTime? @map("birth_date") @db.Date
  /// M | F | X | no_decl — varchar para tolerar valores variados de orígenes
  gender                String?   @db.VarChar(20)
  nationality           String?   @db.VarChar(100)
  /// Tipo de documento principal (DNI, CUIL, RUT, CC…)
  documentType          String?   @map("document_type") @db.VarChar(30)
  documentNumber        String?   @map("document_number") @db.VarChar(50)
  /// Fecha de ingreso — base para cálculo de antigüedad
  hireDate              DateTime  @map("hire_date") @db.Date
  /// Fecha de egreso. null = activo o con estado on_leave
  terminationDate       DateTime? @map("termination_date") @db.Date
  /// Motivo de baja del catálogo global
  terminationReasonCode String?   @map("termination_reason_code")
  /// active | inactive | on_leave
  status                String    @db.VarChar(20)
  /// indefinido | plazo_fijo | contractor | temporal
  /// Self-ref — jefe directo
  managerId             Int?      @map("manager_id")
  /// Banda salarial (etiqueta, no monto exacto)
  salaryBand            String?   @map("salary_band") @db.VarChar(50)
  customFields          Json?     @map("custom_fields")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  terminationReason CfgTerminationReason?   @relation(fields: [terminationReasonCode], references: [code])
  manager           HrPerson?               @relation("PeopleHierarchy", fields: [managerId], references: [id])
  reports           HrPerson[]              @relation("PeopleHierarchy")
  orgAssignments    HrPeopleOrgAssignment[]
  historySnapshots  HrPeopleHistory[]
  timeDailyRecords  AttTimeDaily[]
  absenteeismEvents AttAbsenteeismEvent[]
  payEntries        PayEntry[]

  @@unique([tenantId, employeeCode], name: "uq_hr_people_tenant_code")
  @@index([tenantId, status])
  @@index([tenantId, hireDate])
  @@index([managerId])
  @@map("hr_people")
}

model HrPeopleOrgAssignment {
  /// PK autoincrement
  id              Int       @id @default(autoincrement())
  /// RLS — denormalizado para simplificar policy
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Empleado asignado
  personId        Int       @map("person_id")
  /// Unidad organizativa asignada
  orgUnitId       Int       @map("org_unit_id")
  /// Tipo de la unidad (denormalizado; la FK compuesta garantiza que coincida con la unidad)
  orgUnitTypeCode String    @map("org_unit_type_code")
  /// Inicio de vigencia (obligatorio)
  validFrom       DateTime  @map("valid_from") @db.Date
  /// Fin de vigencia inclusive. null = vigente. Solo una asignación por persona y tipo en cada momento
  /// (restricción de exclusión excl_hr_people_org_assignments_no_overlap, definida en SQL)
  validTo         DateTime? @map("valid_to") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")

  person   HrPerson       @relation(fields: [personId], references: [id])
  orgUnit  HrOrgUnit      @relation(fields: [orgUnitId, orgUnitTypeCode], references: [id, orgUnitTypeCode], map: "hr_people_org_assignments_org_unit_fkey")
  unitType CfgOrgUnitType @relation(fields: [orgUnitTypeCode], references: [code])

  @@unique([tenantId, personId, orgUnitId, validFrom], name: "uq_hr_people_org_assignments", map: "uq_hr_people_org_assignments")
  @@index([tenantId, orgUnitId])
  @@index([tenantId, orgUnitTypeCode, validFrom, validTo], map: "idx_hr_people_org_assignments_type_validity")
  @@map("hr_people_org_assignments")
}

model HrPeopleHistory {
  /// PK autoincrement
  id                     Int      @id @default(autoincrement())
  /// RLS — tenant owner
  tenantId               String   @map("tenant_id") @db.Uuid
  /// Primer día del mes del snapshot: YYYY-MM-01
  snapshotDate           DateTime @map("snapshot_date") @db.Date
  personId               Int      @map("person_id")
  /// Snapshot del código del empleado al momento del cierre
  employeeCode           String   @map("employee_code") @db.VarChar(50)
  /// Estado al cierre del mes
  status                 String   @db.VarChar(20)
  /// Array de asignaciones OU al momento del snapshot
  orgAssignmentsSnapshot Json?    @map("org_assignments_snapshot")
  managerId              Int?     @map("manager_id")
  salaryBand             String?  @map("salary_band") @db.VarChar(50)
  /// Antigüedad en meses al cierre del mes
  tenureMonths           Int?     @map("tenure_months")
  customFieldsSnapshot   Json?    @map("custom_fields_snapshot")
  createdAt              DateTime @default(now()) @map("created_at")

  person HrPerson @relation(fields: [personId], references: [id])

  @@unique([tenantId, snapshotDate, personId], name: "uq_hr_people_history_snapshot")
  @@index([tenantId, snapshotDate])
  @@index([tenantId, personId])
  @@map("hr_people_history")
}

// =============================================================================
// M1 — CONFIGURACIÓN DE UNIDADES ORGANIZATIVAS POR TENANT
// =============================================================================

model CfgTenantOrgUnitType {
  /// PK autoincrement
  id              Int      @id @default(autoincrement())
  /// RLS — tenant owner
  tenantId        String   @map("tenant_id") @db.Uuid
  /// Tipo de unidad organizativa del catálogo global
  orgUnitTypeCode String   @map("org_unit_type_code")
  /// true = el tenant usa este tipo
  isEnabled       Boolean  @default(true) @map("is_enabled")
  /// Orden de presentación para el tenant
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitType CfgOrgUnitType @relation(fields: [orgUnitTypeCode], references: [code])

  @@unique([tenantId, orgUnitTypeCode], name: "uq_cfg_tenant_org_unit_types", map: "uq_cfg_tenant_org_unit_types")
  @@map("cfg_tenant_org_unit_types")
}

model DshDimension {
  /// PK autoincrement
  id              Int      @id @default(autoincrement())
  /// RLS — tenant owner
  tenantId        String   @map("tenant_id") @db.Uuid
  /// Dashboard al que aplica. Ej: headcount
  dashboardCode   String   @map("dashboard_code") @db.VarChar(50)
  /// Tipo de unidad organizativa usado como dimensión (filtro y distribución)
  orgUnitTypeCode String   @map("org_unit_type_code")
  /// Orden de la dimensión dentro del dashboard
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitType CfgOrgUnitType @relation(fields: [orgUnitTypeCode], references: [code])

  @@unique([tenantId, dashboardCode, orgUnitTypeCode], name: "uq_dsh_dimensions", map: "uq_dsh_dimensions")
  @@map("dsh_dimensions")
}

// =============================================================================
// M1 — CONFIG POR TENANT
// =============================================================================

model CfgAbsenteeismType {
  /// PK autoincrement
  id              Int     @id @default(autoincrement())
  /// RLS — cada tenant define sus propios tipos
  tenantId        String  @map("tenant_id") @db.Uuid
  /// Código del tipo en el sistema origen
  code            String  @db.VarChar(50)
  name            String  @db.VarChar(100)
  /// medical | personal | justified | unjustified | other
  category        String  @db.VarChar(30)
  /// false = no impacta en tasa de ausentismo
  countsAsAbsence Boolean @default(true) @map("counts_as_absence")
  customFields    Json?   @map("custom_fields")

  events AttAbsenteeismEvent[]

  @@unique([tenantId, code], name: "uq_cfg_absenteeism_types_tenant_code")
  @@map("cfg_absenteeism_types")
}

// =============================================================================
// M1 — TIME & ATTENDANCE
// =============================================================================

model AttTimeDaily {
  /// PK autoincrement
  id                  Int      @id @default(autoincrement())
  /// RLS
  tenantId            String   @map("tenant_id") @db.Uuid
  personId            Int      @map("person_id")
  /// Fecha del registro diario
  date                DateTime @db.Date
  /// true = día hábil según calendario laboral
  isWorkingDay        Boolean  @map("is_working_day")
  /// Horas teóricas planificadas. 0 si isWorkingDay = false
  scheduledHours      Decimal  @default(0) @map("scheduled_hours") @db.Decimal(5, 2)
  /// Total horas trabajadas independientemente de su categorización
  workedHours         Decimal  @default(0) @map("worked_hours") @db.Decimal(5, 2)
  /// Flag de conveniencia — true si existe al menos una entrada ABSENT
  hasAbsence          Boolean  @default(false) @map("has_absence")
  /// FK int_tenant_integrations — integración que originó el registro
  sourceIntegrationId Int?     @map("source_integration_id")
  customFields        Json?    @map("custom_fields")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  person  HrPerson            @relation(fields: [personId], references: [id])
  entries AttTimeDailyEntry[]

  @@unique([tenantId, personId, date], name: "uq_att_time_daily_tenant_person_date")
  @@index([tenantId, date])
  @@map("att_time_daily")
}

model AttTimeDailyEntry {
  /// PK autoincrement
  id                Int      @id @default(autoincrement())
  /// RLS — denormalizado para simplificar policy
  tenantId          String   @map("tenant_id") @db.Uuid
  timeDailyId       Int      @map("time_daily_id")
  /// Tipo de hora (code de cfg_time_entry_types)
  timeEntryTypeCode String   @map("time_entry_type_code")
  /// Horas de este tipo en el día
  hours             Decimal  @db.Decimal(6, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  timeDaily     AttTimeDaily     @relation(fields: [timeDailyId], references: [id])
  timeEntryType CfgTimeEntryType @relation(fields: [timeEntryTypeCode], references: [code])

  @@unique([tenantId, timeDailyId, timeEntryTypeCode], name: "uq_att_time_daily_entries")
  @@index([tenantId, timeEntryTypeCode])
  @@map("att_time_daily_entries")
}

model AttAbsenteeismEvent {
  /// PK autoincrement
  id                  Int      @id @default(autoincrement())
  /// RLS
  tenantId            String   @map("tenant_id") @db.Uuid
  personId            Int      @map("person_id")
  absenteeismTypeId   Int      @map("absenteeism_type_id")
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date") @db.Date
  /// Días de duración (puede ser fraccionario)
  daysCount           Decimal  @map("days_count") @db.Decimal(5, 2)
  /// Horas totales del evento
  hoursCount          Decimal  @map("hours_count") @db.Decimal(6, 2)
  justified           Boolean  @default(false)
  /// Costo estimado — puede venir del ETL de Payroll
  costEstimated       Decimal? @map("cost_estimated") @db.Decimal(12, 2)
  /// open | closed | cancelled
  status              String   @default("open") @db.VarChar(20)
  notes               String?
  sourceIntegrationId Int?     @map("source_integration_id")
  customFields        Json?    @map("custom_fields")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  person          HrPerson           @relation(fields: [personId], references: [id])
  absenteeismType CfgAbsenteeismType @relation(fields: [absenteeismTypeId], references: [id])

  @@index([tenantId, personId, startDate])
  @@index([tenantId, absenteeismTypeId])
  @@map("att_absenteeism_events")
}

// =============================================================================
// M1 — PAYROLL (simplificado — solo lo necesario para analytics)
// =============================================================================

model PayPeriod {
  /// PK autoincrement
  id         Int      @id @default(autoincrement())
  /// RLS
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Código del período. Ej: 2026-01, 2026-Q1
  periodCode String   @map("period_code") @db.VarChar(20)
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  /// open | closed | cancelled
  status     String   @default("open") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  entries PayEntry[]

  @@unique([tenantId, periodCode], name: "uq_pay_periods_tenant_code")
  @@map("pay_periods")
}

model PayConcept {
  /// PK autoincrement
  id           Int     @id @default(autoincrement())
  /// RLS
  tenantId     String  @map("tenant_id") @db.Uuid
  /// Código del concepto en el sistema origen
  code         String  @db.VarChar(50)
  name         String  @db.VarChar(100)
  /// basic_salary | bonus | overtime | absence_deduction | other
  category     String  @db.VarChar(40)
  /// +1 = ingreso, -1 = deducción
  sign         Int     @default(1) @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")
  customFields Json?   @map("custom_fields")

  entries PayEntry[]

  @@unique([tenantId, code], name: "uq_pay_concepts_tenant_code")
  @@map("pay_concepts")
}

model PayEntry {
  /// PK autoincrement
  id                  Int      @id @default(autoincrement())
  /// RLS
  tenantId            String   @map("tenant_id") @db.Uuid
  periodId            Int      @map("period_id")
  personId            Int      @map("person_id")
  conceptId           Int      @map("concept_id")
  /// Monto del concepto en el período
  amount              Decimal  @db.Decimal(14, 2)
  /// Horas asociadas (HHEE, ausentismo). null si no aplica
  hours               Decimal? @db.Decimal(6, 2)
  sourceIntegrationId Int?     @map("source_integration_id")
  customFields        Json?    @map("custom_fields")
  createdAt           DateTime @default(now()) @map("created_at")

  period  PayPeriod  @relation(fields: [periodId], references: [id])
  person  HrPerson   @relation(fields: [personId], references: [id])
  concept PayConcept @relation(fields: [conceptId], references: [id])

  @@unique([tenantId, periodId, personId, conceptId], name: "uq_pay_entries_period_person_concept")
  @@index([tenantId, periodId, personId])
  @@map("pay_entries")
}

// =============================================================================
// M1-B — INTEGRACIONES
// =============================================================================

model IntTemplate {
  /// PK: slug único del template
  code         String   @id @db.VarChar(50)
  /// Nombre display del template
  name         String   @db.VarChar(100)
  /// file | api
  category     String   @db.VarChar(20)
  /// people | time | payroll | absenteeism
  targetModel  String   @map("target_model") @db.VarChar(40)
  /// JSON Schema para validar el campo config de IntTenantIntegration
  configSchema Json?    @map("config_schema")
  /// false = desactivado globalmente (no aparece en UI)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenantIntegrations IntTenantIntegration[]

  @@map("int_templates")
}

model IntTenantIntegration {
  /// PK autoincrement
  id                      Int       @id @default(autoincrement())
  /// RLS
  tenantId                String    @map("tenant_id") @db.Uuid
  /// Template que implementa esta integración
  integrationTemplateCode String    @map("integration_template_code") @db.VarChar(50)
  /// Nombre amigable definido por el tenant
  name                    String    @db.VarChar(100)
  /// active | paused | error
  status                  String    @default("active") @db.VarChar(20)
  /// Expresión cron. Null si solo manual
  scheduleCron            String?   @map("schedule_cron") @db.VarChar(100)
  /// Reglas de mapping, filtros y defaults. Validado contra IntTemplate.configSchema
  config                  Json
  /// Timestamp del último run iniciado (exitoso o no)
  lastRunAt               DateTime? @map("last_run_at")
  /// Timestamp del último run completado sin errores fatales
  lastSuccessAt           DateTime? @map("last_success_at")
  /// false = integración desactivada por el tenant
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  template    IntTemplate     @relation(fields: [integrationTemplateCode], references: [code])
  runs        IntRun[]
  jobs        Job[]
  checkpoints JobCheckpoint[]

  @@index([tenantId, integrationTemplateCode])
  @@map("int_tenant_integrations")
}

model IntRun {
  /// PK autoincrement
  id                  Int       @id @default(autoincrement())
  /// RLS — denormalizado para simplificar policy
  tenantId            String    @map("tenant_id") @db.Uuid
  /// Integración que originó este run
  tenantIntegrationId Int       @map("tenant_integration_id")
  /// running | success | partial | failed
  status              String    @db.VarChar(20)
  /// cron | manual | upload
  triggerSource       String    @map("trigger_source") @db.VarChar(20)
  /// UUID del usuario que disparó el run, o null si fue automático
  triggeredBy         String?   @map("triggered_by") @db.VarChar(36)
  startedAt           DateTime  @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  /// Filas leídas de la fuente
  rowsRead            Int       @default(0) @map("rows_read")
  /// Filas persistidas exitosamente
  rowsLoaded          Int       @default(0) @map("rows_loaded")
  /// Filas descartadas por error
  rowsError           Int       @default(0) @map("rows_error")
  /// Filas procesadas con advertencias
  rowsWarning         Int       @default(0) @map("rows_warning")
  /// Error fatal si status = failed
  errorMessage        String?   @map("error_message")
  createdAt           DateTime  @default(now()) @map("created_at")

  tenantIntegration IntTenantIntegration @relation(fields: [tenantIntegrationId], references: [id])
  errors            IntRunError[]

  @@index([tenantId, tenantIntegrationId, startedAt])
  @@index([tenantId, status])
  @@map("int_runs")
}

model IntRunError {
  /// PK autoincrement
  id           Int      @id @default(autoincrement())
  /// RLS — denormalizado para simplificar policy
  tenantId     String   @map("tenant_id") @db.Uuid
  runId        Int      @map("run_id")
  /// Posición de la fila en el archivo/respuesta. Null si no es error de fila
  rowIndex     Int?     @map("row_index")
  /// Datos crudos de la fila que falló
  rowData      Json?    @map("row_data")
  /// VALIDATION_ERROR | MAPPING_ERROR | RECONCILIATION_PENDING | etc.
  errorCode    String   @map("error_code") @db.VarChar(50)
  errorMessage String   @map("error_message")
  /// error | warning
  severity     String   @default("error") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  run IntRun @relation(fields: [runId], references: [id])

  @@index([tenantId, runId])
  @@index([tenantId, runId, severity])
  @@map("int_run_errors")
}

// =============================================================================
// M1-E — WORKER JOBS (sin RLS — tablas de plataforma, acceso vía service role)
// =============================================================================

model Job {
  id              Int       @id @default(autoincrement())
  tenantId        String    @map("tenant_id") @db.Uuid
  /// FK a int_tenant_integrations — null para jobs sin integración asociada (ej: hello_world)
  integrationId   Int?      @map("integration_id")
  /// Tipo de job: hello_world | sync_people | sync_time | etc.
  jobType         String    @map("job_type") @db.VarChar(50)
  /// pending | running | completed | failed | retry_scheduled | cancelled
  status          String    @default("pending") @db.VarChar(20)
  priority        Int       @default(0)
  /// Clave única por ejecución lógica — evita duplicados si el scheduler corre dos veces
  runKey          String?   @map("run_key") @db.VarChar(200)
  payload         Json      @default("{}")
  result          Json?
  scheduledAt     DateTime  @default(now()) @map("scheduled_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3) @map("max_attempts")
  nextRetryAt     DateTime? @map("next_retry_at")
  lockedAt        DateTime? @map("locked_at")
  lockedBy        String?   @map("locked_by") @db.VarChar(100)
  heartbeatAt     DateTime? @map("heartbeat_at")
  progressCurrent Int       @default(0) @map("progress_current")
  progressTotal   Int       @default(0) @map("progress_total")
  progressMessage String?   @map("progress_message")
  lastError       String?   @map("last_error")
  lastErrorCode   String?   @map("last_error_code") @db.VarChar(50)
  createdBy       String?   @map("created_by") @db.VarChar(36)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  integration IntTenantIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  runs        JobRun[]
  events      JobEvent[]

  @@unique([tenantId, integrationId, jobType, runKey], name: "uq_jobs_run_key")
  @@index([status, scheduledAt], name: "idx_jobs_status_scheduled")
  @@index([tenantId, status], name: "idx_jobs_tenant_status")
  @@map("jobs")
}

model JobRun {
  id             Int       @id @default(autoincrement())
  jobId          Int       @map("job_id")
  tenantId       String    @map("tenant_id") @db.Uuid
  workerId       String    @map("worker_id") @db.VarChar(100)
  /// running | completed | failed | cancelled | timeout | worker_shutdown
  status         String    @db.VarChar(20)
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     BigInt?   @map("duration_ms")
  processedCount Int       @default(0) @map("processed_count")
  successCount   Int       @default(0) @map("success_count")
  failedCount    Int       @default(0) @map("failed_count")
  skippedCount   Int       @default(0) @map("skipped_count")
  errorMessage   String?   @map("error_message")
  errorCode      String?   @map("error_code") @db.VarChar(50)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")

  job    Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events JobEvent[]

  @@index([jobId], name: "idx_job_runs_job_id")
  @@index([tenantId, status], name: "idx_job_runs_tenant_status")
  @@map("job_runs")
}

model JobEvent {
  id        Int      @id @default(autoincrement())
  jobId     Int      @map("job_id")
  jobRunId  Int?     @map("job_run_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  /// job_created | job_claimed | job_started | job_completed | job_failed | retry_scheduled
  eventType String   @map("event_type") @db.VarChar(50)
  /// debug | info | warning | error | critical
  level     String   @default("info") @db.VarChar(10)
  message   String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  job    Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobRun JobRun? @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt(sort: Desc)], name: "idx_job_events_job_created")
  @@index([tenantId, createdAt(sort: Desc)], name: "idx_job_events_tenant_created")
  @@map("job_events")
}

model JobCheckpoint {
  id              Int       @id @default(autoincrement())
  tenantId        String    @map("tenant_id") @db.Uuid
  integrationId   Int       @map("integration_id")
  /// last_external_id | last_updated_at | last_file_processed | last_page_token | etc.
  checkpointType  String    @map("checkpoint_type") @db.VarChar(50)
  checkpointValue String?   @map("checkpoint_value")
  checkpointData  Json      @default("{}") @map("checkpoint_data")
  lastSuccessAt   DateTime? @map("last_success_at")
  lastAttemptAt   DateTime? @map("last_attempt_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  integration IntTenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationId, checkpointType], name: "uq_job_checkpoints_tenant_integration_type")
  @@index([tenantId, integrationId], name: "idx_job_checkpoints_tenant_integration")
  @@map("job_checkpoints")
}

// =============================================================================
// AUDIT_LOG
// =============================================================================
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_log")
}
