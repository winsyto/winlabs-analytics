{
  "name": "@wla/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:prod": "dotenv -e .env.production.local -- prisma migrate deploy",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:seed:prod": "dotenv -e .env.production.local -- tsx src/seed/index.ts",
    "db:seed:test": "dotenv -e .env.test -- tsx src/seed/index.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@wla/config": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^8.0.0",
    "vitest": "^3.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
